# =========================================
# Global ignores (applies to all folders)
# =========================================

# Node modules
**/node_modules/

# Environment variables
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test

# Build outputs
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
Thumbs.db

# IDE/editor config
.vscode/
.idea/
*.swp

# =========================================
# Angular Frontend Specific
# =========================================

frontend/.angular/
frontend/.cache/
frontend/coverage/
frontend/.firebase/
frontend/tmp/
frontend/src/environments/  # optional: if you're using .env instead

# =========================================
# Node.js + Express.js Backend Specific
# =========================================

backend/.cache/
backend/coverage/
backend/tmp/
backend/uploads/
backend/public/uploads/
backend/.eslintcache
backend/.nodemon-debug.json

# =========================================
# Optional: Ignore lock files (if you don't use them for exact versions)
# =========================================
# **/package-lock.json
# **/yarn.lock
